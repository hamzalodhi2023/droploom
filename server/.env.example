# Copy this file to `.env` and adjust values as needed.
# `.env` is git-ignored; never commit real secrets.

# development | test | production
NODE_ENV=development

# HTTP port for the API
PORT=4000

# SQLite database file (relative paths resolve from the server directory)
DATABASE_PATH=./data/droploom.sqlite

# Directory where uploaded files are stored (never web-served)
UPLOAD_DIR=./storage

# Maximum accepted size per file, in bytes (default 100 MB)
MAX_FILE_SIZE=104857600

# Origin allowed by CORS (the Vite dev server by default)
FRONTEND_ORIGIN=http://localhost:5173

# How often the expired-file cleanup job runs, in minutes
CLEANUP_INTERVAL_MINUTES=1

# Requests per 15-minute window
RATE_LIMIT_API_MAX=300
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_DOWNLOAD_MAX=120
